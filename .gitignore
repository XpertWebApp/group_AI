*.sql
!prisma/migrations/**/*.sql

# IDE and OS
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db


# Documentation & diagrams (keep README.md and DEPLOY.md only)
*.md
!README.md
!DEPLOY.md
*.mmd
*.dbml
*.pdf
*.docx
*.txt

# Public files (docs, images, Figma assets)
# Most of this folder is local reference material (Figma exports, brand-
# guideline PDFs, scratch docs). We track ONLY the runtime assets that the
# PDF generator and email templates need to render correctly on live —
# everything else stays ignored.
src/publicfiles/*
!src/publicfiles/group-offer-header.png
!src/publicfiles/sett-logo-no-bg.png
!src/publicfiles/fonts/
src/publicfiles/fonts/*
!src/publicfiles/fonts/Montserrat-Regular.ttf
!src/publicfiles/fonts/Montserrat-Medium.ttf
!src/publicfiles/fonts/Montserrat-SemiBold.ttf
!src/publicfiles/fonts/Montserrat-Bold.ttf
