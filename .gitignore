# Dependencies
node_modules/

# Build
dist/
build/
*.tsbuildinfo

# Environment variables
.env
*.env
*.env.local
*.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Testing
coverage/

# Prisma
/src/generated/prisma/

# Database dumps
*.sql.gz
*.dump
