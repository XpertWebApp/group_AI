# E2E Test Configuration
# Copy this to .env.test and update values as needed

# Server base URL (must be running before tests)
TEST_BASE_URL=http://localhost:4000

# Dedicated e2e account — create/repair it with `npm run seed:test-user`.
# Deliberately not a staff account: staff passwords change, and a test run
# should never depend on a human's credentials.
TEST_USER_EMAIL=e2e@test.local
TEST_USER_PASSWORD=E2eTest!2026
