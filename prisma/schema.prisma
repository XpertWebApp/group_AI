generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app", "audit", "auth", "cache", "master"]
}

model SyncJob {
  id               String    @id @default(uuid()) @db.Uuid
  type             String
  status           JobStatus
  totalRecords     Int?
  processedRecords Int       @default(0)
  lastProcessedKey String?
  errorMessage     String?
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")

  @@map("sync_jobs")
  @@schema("audit")
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityId])
  @@index([entity, entityId, createdAt])
  @@map("audit_events")
  @@schema("audit")
}

model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("user_roles")
  @@schema("auth")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  password     String
  firstName    String?   @map("first_name") @db.VarChar(100)
  lastName     String?   @map("last_name") @db.VarChar(100)
  roleId       String    @map("role_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  refreshToken       String?   @map("refresh_token")
  // DEPRECATED: Google OAuth columns. Email sending now uses Brevo SMTP only.
  // Kept as nullable columns to avoid a destructive migration; no code reads them.
  // Drop in a future migration once we're confident no rollback needs them.
  googleAccessToken  String?   @map("google_access_token")
  googleRefreshToken String?   @map("google_refresh_token")
  googleTokenExpiry  DateTime? @map("google_token_expiry")
  googleEmail        String?   @map("google_email") @db.VarChar(255)
  role               UserRole  @relation(fields: [roleId], references: [id])
  assignedRequests   BookingRequest[] @relation("BookingRequestAssignee")
  createdBookings    Booking[]        @relation("BookingCreatedBy")

  @@index([roleId])
  @@map("users")
  @@schema("auth")
}

model Destination {
  id           Int           @id
  name         String        @db.VarChar(255)
  countryCode  String?       @map("country_code") @db.VarChar(10)
  region       String?       @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at")
  lastSyncedAt DateTime?     @map("last_synced_at")
  metadata     Json?
  parentId     Int?          @map("parent_id")
  parent       Destination?  @relation("DestinationHierarchy", fields: [parentId], references: [id])
  children     Destination[] @relation("DestinationHierarchy")

  @@index([name])
  @@index([parentId])
  @@map("destinations")
  @@schema("master")
}

model Currency {
  code      String   @id @db.VarChar(10)
  name      String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("currencies")
  @@schema("master")
}

model Nationality {
  code      String   @id @db.VarChar(10)
  name      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("nationalities")
  @@schema("master")
}

model Language {
  code      String   @id @db.VarChar(10)
  name      String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("languages")
  @@schema("master")
}

model Hotel {
  hotelCode        String    @id @map("hotel_code") @db.VarChar(255)
  name             String    @db.VarChar(255)
  masterHotelId    Int?      @map("master_hotel_id")
  hotelDetailsUrl  String?   @map("hotel_details_url")
  destinationId    Int?      @map("destination_id")
  starRating       Decimal?  @map("star_rating") @db.Decimal(2, 1)
  /** Physical room count from WBE static data. Used for Step 3.2 inventory overlap check. NULL = unknown. */
  totalRooms       Int?      @map("total_rooms")
  category         String?   @db.VarChar(50)
  giataCode        String?   @map("giata_code") @db.VarChar(50)
  address          String?
  addressCity      String?   @map("address_city") @db.VarChar(255)
  addressCountry   String?   @map("address_country") @db.VarChar(10)
  latitude         Decimal?  @db.Decimal(10, 7)
  longitude        Decimal?  @db.Decimal(10, 7)
  propertyType     Int?      @map("property_type")
  supplierCode     String?   @map("supplier_code") @db.VarChar(50)
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSyncedAt     DateTime? @map("last_synced_at")
  detailsFetchedAt DateTime? @map("details_fetched_at")
  giataSyncedAt    DateTime? @map("giata_synced_at")
  giataStatus      String?   @map("giata_status") @db.VarChar(20)

  @@index([destinationId, name])
  @@index([destinationId])
  @@index([supplierCode])
  @@index([name])
  @@map("hotels")
  @@schema("master")
}

model Facility {
  id        Int      @id
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([name])
  @@map("facilities")
  @@schema("master")
}

model HotelFacility {
  id         String   @id @default(uuid()) @db.Uuid
  hotelCode  String   @map("hotel_code") @db.VarChar(255)
  facilityId Int      @map("facility_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([hotelCode])
  @@index([facilityId])
  @@index([hotelCode, facilityId])
  @@map("hotel_facilities")
  @@schema("master")
}

model HotelImage {
  id           String   @id @default(uuid()) @db.Uuid
  hotelCode    String   @map("hotel_code") @db.VarChar(64)
  imageKey     String   @map("image_key")
  displayOrder Int      @default(0) @map("display_order")
  caption      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([hotelCode])
  @@index([hotelCode, displayOrder])
  @@map("hotel_images")
  @@schema("master")
}

model HotelFacilityGroup {
  id         String   @id @default(uuid()) @db.Uuid
  hotelCode  String   @map("hotel_code") @db.VarChar(64)
  groupType  String   @map("group_type") @db.VarChar(20)
  category   String?  @db.VarChar(255)
  facilities Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([hotelCode])
  @@index([groupType])
  @@map("hotel_facility_groups")
  @@schema("master")
}

// ─── GIATA MHG: Multilingual hotel text sections ─────────────────────────────
model HotelGiataText {
  id          String    @id @default(uuid()) @db.Uuid
  hotelCode   String    @map("hotel_code") @db.VarChar(255)
  giataId     String    @map("giata_id") @db.VarChar(50)
  lang        String    @db.VarChar(10)
  sectionType String    @map("section_type") @db.VarChar(20)
  title       String    @db.VarChar(255)
  content     String    @db.Text
  lastUpdate  DateTime? @map("last_update")
  syncedAt    DateTime  @default(now()) @map("synced_at")

  @@unique([hotelCode, lang, sectionType])
  @@index([hotelCode])
  @@index([giataId])
  @@map("hotel_giata_texts")
  @@schema("master")
}

// ─── GIATA MHG: Structured fact sheet data ───────────────────────────────────
model HotelGiataFact {
  id          String   @id @default(uuid()) @db.Uuid
  hotelCode   String   @map("hotel_code") @db.VarChar(255)
  giataId     String   @map("giata_id") @db.VarChar(50)
  sectionType String   @map("section_type") @db.VarChar(20)
  sectionName String   @map("section_name") @db.VarChar(100)
  factId      Int      @map("fact_id")
  factName    String   @map("fact_name") @db.VarChar(100)
  typeHint    String   @map("type_hint") @db.VarChar(20)
  value       String   @db.VarChar(500)
  unit        String?  @db.VarChar(20)
  fee         Boolean? @default(false)
  syncedAt    DateTime @default(now()) @map("synced_at")

  @@unique([hotelCode, factId])
  @@index([hotelCode])
  @@index([sectionType])
  @@map("hotel_giata_facts")
  @@schema("master")
}

// ─── GIATA MHG: Hotel image URLs ─────────────────────────────────────────────
model HotelGiataImage {
  id           String    @id @default(uuid()) @db.Uuid
  hotelCode    String    @map("hotel_code") @db.VarChar(255)
  giataId      String    @map("giata_id") @db.VarChar(50)
  imageType    String    @map("image_type") @db.VarChar(5)
  displayOrder Int       @default(0) @map("display_order")
  urlSmall     String?   @map("url_small")
  urlMedium    String?   @map("url_medium")
  urlLarge     String?   @map("url_large")
  /// Full HD variant (maxwidth=1920, typically 1624×1080). Populated on re-sync.
  urlFullHd    String?   @map("url_full_hd")
  /// Original / 4K variant (maxwidth=3840, typically 3248×2160). Populated on re-sync.
  urlOriginal  String?   @map("url_original")
  lastUpdate   DateTime? @map("last_update")
  syncedAt     DateTime  @default(now()) @map("synced_at")

  @@index([hotelCode])
  @@index([hotelCode, displayOrder])
  @@map("hotel_giata_images")
  @@schema("master")
}

// ─── GIATA Multicodes: Supplier/GDS mapping codes ────────────────────────────
model HotelGiataMapping {
  id           String   @id @default(uuid()) @db.Uuid
  hotelCode    String   @map("hotel_code") @db.VarChar(255)
  giataId      String   @map("giata_id") @db.VarChar(50)
  providerCode String   @map("provider_code") @db.VarChar(50)
  providerType String   @map("provider_type") @db.VarChar(20)
  codeValue    String   @map("code_value") @db.VarChar(255)
  syncedAt     DateTime @default(now()) @map("synced_at")

  @@unique([hotelCode, providerCode, codeValue])
  @@index([hotelCode])
  @@index([giataId])
  @@index([providerCode])
  @@map("hotel_giata_mappings")
  @@schema("master")
}

model BookingRequest {
  id                     String                     @id @default(uuid()) @db.Uuid
  rawPayload             Json                       @map("raw_payload")
  externalRequestId      String?                    @map("external_request_id") @db.VarChar(255)
  source                 String?                    @db.VarChar(100)
  sourceIp               String?                    @map("source_ip") @db.VarChar(50)
  budget                 Decimal?                   @db.Decimal(12, 2)
  companyName            String?                    @map("company_name") @db.VarChar(255)
  contactName            String?                    @map("contact_name") @db.VarChar(255)
  contactEmail           String?                    @map("contact_email") @db.VarChar(255)
  contactPhone           String?                    @map("contact_phone") @db.VarChar(50)
  contactPhoneCountryCode String?                   @map("contact_phone_country_code") @db.VarChar(8)
  currencyCode           String?                    @map("currency_code") @db.VarChar(10)
  destinationName        String?                    @map("destination_name") @db.VarChar(255)
  destinationId          Int                        @map("destination_id")
  checkinDate            DateTime                   @map("checkin_date") @db.Date
  nights                 Int
  rooms                  Json?
  nationalityCode        String?                    @map("nationality_code") @db.VarChar(10)
  processed              Boolean                    @default(false)
  processedAt            DateTime?                  @map("processed_at")
  specialRequirements    String?                    @map("special_requirements")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime?                  @updatedAt @map("updated_at")
  status                 BookingRequestStatus       @default(pending)
  referenceNumber        Int                        @unique @default(autoincrement()) @map("reference_number")
  checkoutDate           DateTime?                  @map("checkout_date") @db.Date
  /// Legacy single-value star rating. Kept for back-compat so historic
  /// requests and the Wix webhook (which sends one value) still work.
  /// New requests should populate `starRatings` instead; the search
  /// pipeline reads `starRatings` first and falls back to `[starRating]`.
  starRating             Decimal?                   @map("star_rating") @db.Decimal(2, 1)
  /// Multi-select star categories — one entry per ticked box on the
  /// Create Request form. Example: a user picking 3★ + 4★ stores
  /// `[3.0, 4.0]` here. The search pipeline ORs the half-star ranges
  /// of each entry together (e.g. 2.5-3.5 OR 3.5-4.5), then the ±1
  /// relaxation ladder widens that union further.
  starRatings            Decimal[]                  @map("star_ratings") @db.Decimal(2, 1)
  budgetRange            String?                    @map("budget_range") @db.VarChar(100)
  groupType              String?                    @map("group_type") @db.VarChar(100)
  groupSize              Int?                       @map("group_size")
  averageAge             Int?                       @map("average_age")
  breakfastPreference    String?                    @map("breakfast_preference") @db.VarChar(10)
  hotelLocation          String?                    @map("hotel_location") @db.VarChar(50)
  firstName              String?                    @map("first_name") @db.VarChar(100)
  lastName               String?                    @map("last_name") @db.VarChar(100)
  guestListFileKey       String?                    @map("guest_list_file_key")
  customerNotes          String?                    @map("customer_notes")
  termsAndConditions     String?                    @map("terms_and_conditions")
  cancellationConditions String?                    @map("cancellation_conditions")
  /// German (HTML) auto-translation of the per-offer policy overrides, produced
  /// via the free translator at save time and refreshed when the base field
  /// changes. NULL = not translated yet; FE/PDF fall back to the base field.
  termsAndConditionsDe     String?                  @map("terms_and_conditions_de")
  cancellationConditionsDe String?                  @map("cancellation_conditions_de")
  assignedUserId         String?                    @map("assigned_user_id") @db.Uuid
  assignedUser           User?                      @relation("BookingRequestAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// Terminal-detection signal for the polling frontend.
  /// Values: 'in_progress' | 'settled' | 'exhausted'. NULL = no search has run yet
  /// (frontend treats NULL as 'in_progress' for safety).
  searchPhase            String?                    @map("search_phase") @db.VarChar(20)
  /// Last-known pagination cursor for the manual hotel-search flow. Holds
  /// { usedDestinationId, starRatings, totalCandidates, nextOffset } — the
  /// watcher persists this just before broadcasting searchSettled so that
  /// a subsequent "Search More" click can resume pagination exactly where
  /// it left off. NULL when no cursor is available (search exhausted, or
  /// pre-feature row).
  searchPaginationCursor Json?                      @map("search_pagination_cursor")
  /// Odoo CRM link. NULL = request not yet linked to an Odoo company.
  /// For requests created on/after ODOO_GATE_ACTIVE_SINCE this must be
  /// populated before the offer can be sent (see proposals.service).
  /// Pre-cutover rows are grandfathered (the gate checks createdAt).
  odooContactId          Int?                       @map("odoo_contact_id")
  attachments            BookingRequestAttachment[]
  proposals              Proposal[]
  bookings               Booking[]

  @@index([destinationId])
  @@index([assignedUserId])
  @@index([status])
  @@index([nationalityCode])
  @@index([createdAt])
  @@index([referenceNumber])
  @@index([companyName])
  @@index([odooContactId])
  @@map("booking_requests")
  @@schema("app")
}

model BookingRequestAttachment {
  id               String         @id @default(uuid()) @db.Uuid
  bookingRequestId String         @map("booking_request_id") @db.Uuid
  fileKey          String         @map("file_key")
  originalName     String         @map("original_name") @db.VarChar(500)
  mimeType         String?        @map("mime_type") @db.VarChar(100)
  size             Int?
  createdAt        DateTime       @default(now()) @map("created_at")
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  @@index([bookingRequestId])
  @@map("booking_request_attachments")
  @@schema("app")
}

model Proposal {
  id             String            @id @default(uuid()) @db.Uuid
  requestId      String?           @map("request_id") @db.Uuid
  totalBuy       Decimal?          @map("total_buy") @db.Decimal(12, 2)
  totalSell      Decimal?          @map("total_sell") @db.Decimal(12, 2)
  markupSettings Json?             @map("markup_settings")
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime?         @updatedAt @map("updated_at")
  lockedAt       DateTime?         @map("locked_at")
  lockedBy       String?           @map("locked_by") @db.Uuid
  sentAt           DateTime?         @map("sent_at")
  sentBy           String?           @map("sent_by") @db.Uuid
  sentToEmail      String?           @map("sent_to_email") @db.VarChar(255)
  status           ProposalStatus    @default(draft)
  approvedAt       DateTime?         @map("approved_at")
  approvedBy       String?           @map("approved_by") @db.Uuid
  rejectedAt       DateTime?         @map("rejected_at")
  rejectedBy       String?           @map("rejected_by") @db.Uuid
  rejectionReason  String?           @map("rejection_reason")
  pdfUrl           String?           @map("pdf_url") @db.Text
  /// Customer payment deadline. Staff-set on the proposal — no automatic
  /// default. The Send Offer flow refuses to send while this is null.
  /// Application-layer guard enforces that this date must be earlier
  /// than the earliest effective cancellation deadline across all hotels
  /// on the proposal (so the customer pays before any cancellation
  /// window closes).
  paymentDeadline      DateTime? @map("payment_deadline") @db.Timestamptz(6)
  /// UUID of the staff user who set the most recent paymentDeadline.
  /// Null when paymentDeadline is null.
  paymentDeadlineSetBy String?   @map("payment_deadline_set_by") @db.Uuid
  /// Timestamp of the most recent paymentDeadline change (set or cleared).
  /// Used for audit display.
  paymentDeadlineSetAt DateTime? @map("payment_deadline_set_at") @db.Timestamptz(6)
  hotels           ProposalHotel[]
  services         ProposalService[]
  offers           ProposalOffer[]
  bookingRequest   BookingRequest?   @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@index([status])
  @@index([sentAt])
  @@index([lockedAt])
  @@map("proposals")
  @@schema("app")
}

model ProposalOffer {
  id              String    @id @default(uuid()) @db.Uuid
  proposalId      String    @map("proposal_id") @db.Uuid
  offerNumber     Int       @map("offer_number")
  type            String    @db.VarChar(20)
  pdfKey          String    @map("pdf_key") @db.Text
  pdfUrl          String    @map("pdf_url") @db.Text
  sentAt          DateTime  @default(now()) @map("sent_at")
  sentBy          String    @map("sent_by") @db.Uuid
  sentToEmails    String[]  @map("sent_to_emails")
  hotelSnapshot   Json?     @map("hotel_snapshot")
  serviceSnapshot Json?     @map("service_snapshot")
  totalPrice      Decimal?  @map("total_price") @db.Decimal(12, 2)
  currency        String?   @db.VarChar(10)
  method          String?   @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at")
  proposal        Proposal  @relation(fields: [proposalId], references: [id])

  @@unique([proposalId, offerNumber])
  @@index([proposalId])
  @@index([sentAt])
  @@map("proposal_offers")
  @@schema("app")
}

model ProposalHotel {
  id                   String    @id @default(uuid()) @db.Uuid
  proposalId           String    @map("proposal_id") @db.Uuid
  hotelCode            String    @map("hotel_code") @db.VarChar(255)
  hotelName            String?   @map("hotel_name") @db.VarChar(500)
  tid                  String?   @db.VarChar(255)
  totalPrice           Decimal   @map("total_price") @db.Decimal(12, 2)
  currency             String    @db.VarChar(10)
  freeCancellation     Boolean?  @map("free_cancellation")
  /// Supplier's cancellation deadline as returned by WBE's optionDetailsV2
  /// (CxlPolicy.OptionDate). Authoritative — never overwritten so we keep
  /// an audit trail of what the supplier actually committed to.
  cancelDeadline       DateTime? @map("cancel_deadline") @db.Timestamptz(6)
  /// Optional staff-set override of the cancellation deadline. When present,
  /// this date is used in the customer-facing PDF and FE display INSTEAD of
  /// `cancelDeadline`. Application-layer guard enforces that overrides must
  /// be EARLIER than the supplier's `cancelDeadline` (can't overpromise).
  cancelDeadlineOverride       DateTime? @map("cancel_deadline_override") @db.Timestamptz(6)
  /// UUID of the staff user who set the most recent override. Null when no
  /// override is set. Reset to null when override is cleared.
  cancelDeadlineOverriddenBy   String?   @map("cancel_deadline_overridden_by") @db.Uuid
  /// Timestamp of the most recent override action (set or cleared). Used for
  /// audit display ("Set by Vincent on 12 Jun 2026").
  cancelDeadlineOverriddenAt   DateTime? @map("cancel_deadline_overridden_at") @db.Timestamptz(6)
  supplierCode         String?   @map("supplier_code") @db.VarChar(50)
  rooms                Json?
  latitude             Decimal?  @db.Decimal(10, 7)
  longitude            Decimal?  @db.Decimal(10, 7)
  starRating           Int?      @map("star_rating")
  address              String?
  addressCity          String?   @map("address_city") @db.VarChar(255)
  addressCountry       String?   @map("address_country") @db.VarChar(10)
  hotelRef             String?   @map("hotel_ref") @db.VarChar(32)
  /// Public SETTHub hotel-detail URL (e.g. https://booking.s-e-t-t.com/Availability/Hotel/Details/<b64>).
  /// Persisted on add-hotel so the dashboard's Request Summary page can
  /// render the hotel name as a clickable deep-link into SETTHub. Null
  /// for rows added before the column existed and for hotels whose
  /// `masterHotelId` isn't synced yet — the FE renders a plain heading
  /// in that case.
  sethubDetailsUrl     String?   @map("sethub_details_url") @db.Text
  optionDetailsId      String?   @map("option_details_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  deletedAt            DateTime? @map("deleted_at")
  optionDetailsFetched Boolean   @default(false) @map("option_details_fetched")
  includedInTotal      Boolean   @default(true) @map("included_in_total")
  proposal             Proposal  @relation(fields: [proposalId], references: [id])

  @@index([proposalId])
  @@index([hotelCode])
  @@index([tid])
  @@index([optionDetailsId])
  @@index([proposalId, deletedAt])
  @@unique([proposalId, hotelRef], map: "proposal_hotels_proposal_id_hotel_ref_key")
  @@map("proposal_hotels")
  @@schema("app")
}

model ProposalService {
  id          String    @id @default(uuid()) @db.Uuid
  proposalId  String    @map("proposal_id") @db.Uuid
  serviceName String?   @map("service_name") @db.VarChar(255)
  dateFrom    DateTime? @map("date_from") @db.Date
  dateTo      DateTime? @map("date_to") @db.Date
  buyPrice    Decimal?  @map("buy_price") @db.Decimal(12, 2)
  sellPrice   Decimal?  @map("sell_price") @db.Decimal(12, 2)
  currency    String?   @map("currency") @db.VarChar(10)
  quantity    Int?
  days        Int?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  includedInTotal Boolean @default(true) @map("included_in_total")
  proposal    Proposal  @relation(fields: [proposalId], references: [id])

  @@index([proposalId])
  @@map("proposal_services")
  @@schema("app")
}

model Notification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       String   @db.VarChar(100)
  title      String   @db.VarChar(255)
  message    String
  entityId   String?  @map("entity_id") @db.Uuid
  entityType String?  @map("entity_type") @db.VarChar(100)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityId])
  @@index([read, createdAt], map: "notifications_read_created_idx")
  @@map("notifications")
  @@schema("app")
}

model HotelOptionDetail {
  id                 String    @id @default(uuid()) @db.Uuid
  tid                String    @unique @db.VarChar(255)
  hotelCode          String?   @map("hotel_code") @db.VarChar(255)
  data               Json
  fetchedAt          DateTime  @default(now()) @map("fetched_at")
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  nonRefundable      Boolean?  @map("non_refundable")
  cxlOptionDate      DateTime? @map("cxl_option_date")
  cxlConditions      Json?     @map("cxl_conditions")
  cxlComment         String?   @map("cxl_comment")
  cxlRemarks         Json?     @map("cxl_remarks")
  daypricesTotal     Decimal?  @map("dayprices_total") @db.Decimal(12, 2)
  daypricesCurrency  String?   @map("dayprices_currency") @db.VarChar(10)
  mealType           String?   @map("meal_type") @db.VarChar(10)
  mealName           String?   @map("meal_name") @db.VarChar(255)
  providerPrice      Decimal?  @map("provider_price") @db.Decimal(12, 2)
  providerCurrency   String?   @map("provider_currency") @db.VarChar(10)
  supplierCode       String?   @map("supplier_code") @db.VarChar(50)
  essentialInfo      String?   @map("essential_info")
  priceComment       String?   @map("price_comment")
  supplements        Json?
  optionalExtras     Json?     @map("optional_extras")
  specialOffers      Json?     @map("special_offers")
  rooms              Json?
  success            Boolean?
  versionDescription String?   @map("version_description") @db.VarChar(100)

  @@index([hotelCode])
  @@index([fetchedAt])
  @@index([expiresAt])
  @@index([daypricesTotal])
  @@map("hotel_option_details")
  @@schema("cache")
}

enum JobStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@schema("audit")
}

enum BookingRequestStatus {
  pending
  draft
  processing
  completed
  cancelled
  ai_generated
  sent
  declined
  /// Auto-search exhausted all relaxation levels and destination fallbacks
  /// without finding hotels. Staff must handle this request manually.
  needs_manual_handling

  @@schema("app")
}

enum ProposalStatus {
  draft
  pending_admin_approval
  sent
  approved
  declined

  @@schema("app")
}

// ── Settings ────────────────────────────────────────────────────────────────

model Setting {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category  SettingCategory
  key       String           @db.VarChar(100)
  value     String?
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([category, key])
  @@index([category])
  @@map("settings")
  @@schema("app")
}

enum SettingCategory {
  general
  email
  company
  policies

  @@schema("app")
}

enum HotelProbeJobStatus {
  QUEUED
  RUNNING
  PROBING
  COMPLETED
  SKIPPED_INSUFFICIENT
  FAILED

  @@schema("app")
}

/// Priority tier for supplier selection during hotel search allocation.
/// Higher tiers are allocated first; within the same tier, cheapest-first
/// is the tie-breaker.
///
/// Mapping to Oliver's own words (2026-07-XX):
///   HIGH   = "push"     — HyperGuest, Roibos (unlimited rooms)
///   MEDIUM = "preferred" — Expedia (PKG + SA), SNH, DOTW
///   LOW    = "careful"   — HBA, GG, RMXML, ABR, TBO (max 5-6 rooms)
///   AVOID  = "avoid"     — TLE, TBX, POW (only used if nothing else can fulfil)
///
/// Notes:
///   - AVOID is NOT the same as groupsAllowed=false. AVOID suppliers are
///     still eligible if no higher-priority supplier can fulfil the room;
///     groupsAllowed=false excludes them entirely.
///   - New / unknown suppliers default to MEDIUM (see refreshSupplierLimitsCache).
enum SupplierPriority {
  HIGH
  MEDIUM
  LOW
  AVOID

  @@schema("app")
}

model HotelProbeJob {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  searchRequestId String              @map("search_request_id") @db.Uuid
  hotelCode       String              @map("hotel_code") @db.VarChar(255)
  requestedRooms  Int                 @map("requested_rooms")
  probeLimit      Int                 @map("probe_limit")
  roomsFound      Int                 @default(0) @map("rooms_found")
  status          HotelProbeJobStatus @default(QUEUED)
  lastProbeRange  String?             @map("last_probe_range") @db.VarChar(20)
  attempts        Int                 @default(0)
  startedAt       DateTime?           @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz(6)
  resultJson      Json?               @map("result_json")
  optionsSnapshot Json?               @map("options_snapshot")
  errorMsg        String?             @map("error_msg")
  /// 'main' = exact-criteria search; 'alternative' = relaxed-criteria search.
  searchKind        String  @default("main") @map("search_kind") @db.VarChar(20)
  /// Short label for why this is an alternative (e.g. 'Wider star rating').
  /// Null when searchKind = 'main'.
  alternativeReason String? @map("alternative_reason") @db.VarChar(80)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([searchRequestId])
  @@index([status])
  @@index([searchRequestId, status])
  @@map("hotel_probe_jobs")
  @@schema("app")
}

model SupplierLimit {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierCode  String   @map("supplier_code") @db.VarChar(50)
  providerName  String   @map("provider_name") @db.VarChar(255)
  accCode       String?  @map("acc_code") @db.VarChar(50)
  maxRooms      Int      @default(9) @map("max_rooms")
  groupsAllowed Boolean  @default(true) @map("groups_allowed")
  /// Priority tier for allocation sorting during hotel search.
  /// HIGH suppliers are picked first, cheapest-first within the same tier.
  /// AVOID is a last-resort tier — used only when no other supplier can fulfil
  /// a hotel's room-type demand. Default is MEDIUM for new/unknown suppliers.
  priority      SupplierPriority @default(MEDIUM)
  notes         String?
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([supplierCode])
  @@map("supplier_limits")
  @@schema("app")
}

/// Dead-letter queue for outbound emails that exhausted all retry attempts.
/// One row per failed email; staff are alerted via in-app notification on insertion.
/// Phase 1 has no admin UI — rows here exist for audit/debug + future manual replay.
model FailedEmail {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(64)
  recipient     String    @db.VarChar(255)
  subject       String    @db.VarChar(500)
  body          String
  replyTo       String?   @map("reply_to") @db.VarChar(255)
  requestId     String?   @map("request_id") @db.Uuid
  proposalId    String?   @map("proposal_id") @db.Uuid
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  lastAttemptAt DateTime? @map("last_attempt_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  resolvedAt    DateTime? @map("resolved_at")

  @@index([eventType])
  @@index([requestId])
  @@index([proposalId])
  @@index([resolvedAt])
  @@map("failed_emails")
  @@schema("app")
}

// ── WBE Hotel Booking (XMLOUT) ──────────────────────────────────────────────
// Models backing the WBE booking lifecycle:
//   Search → OptionDetailsV2(Prebook=false) → OptionDetailsV2(Prebook=true)
//   → BookV2 → BookingDetails / IssueVoucher / CancelBookingV2
//
// A Booking row is created BEFORE the BookV2 call is dispatched, so that a
// network failure mid-call cannot orphan a reservation that exists on WBE's
// side but is unknown to us. `agencyReference` is generated up front and is
// the idempotency key used to recover such bookings via
// `bookingDetails?agencyReference=`.

model Booking {
  id String @id @default(uuid()) @db.Uuid

  /// Our own unique reference sent to WBE as `AgencyReference`. WBE mandates
  /// this be unique per booking; the DB unique constraint is the enforcement
  /// point. Also used to recover a booking whose BookV2 response was lost.
  agencyReference String @unique @map("agency_reference") @db.VarChar(64)

  /// Reference returned by WBE. NULL until BookV2 succeeds — its absence is
  /// how we detect a booking that failed or was never dispatched.
  bookingReference String? @unique @map("booking_reference") @db.VarChar(64)

  /// The supplier's own reference, surfaced by BookingDetails.
  providerReference String? @map("provider_reference") @db.VarChar(64)

  /// Internal lifecycle state. Distinct from `wbeStatus`: this tracks OUR
  /// progress through the flow (including pre-dispatch states WBE never sees),
  /// while `wbeStatus` mirrors whatever WBE last told us.
  status BookingFlowStatus @default(draft)

  /// Raw WBE booking status: PNDN | CNF | VCHR | CLX | PNDC | RJ.
  /// Stored verbatim rather than mapped to an enum so an unexpected value
  /// from WBE is never silently coerced.
  wbeStatus String? @map("wbe_status") @db.VarChar(10)

  // ── WBE session binding ──────────────────────────────────────────────────
  // BookV2 requires the SessionID/TID/HotelCode triplet from the originating
  // search. Sessions expire on WBE's side, so these are persisted the moment
  // an option is selected rather than being held in memory.
  sessionId String @map("session_id") @db.VarChar(255)
  tid       String @map("tid") @db.VarChar(255)
  hotelCode String @map("hotel_code") @db.VarChar(255)

  hotelName       String? @map("hotel_name") @db.VarChar(255)
  destinationId   Int?    @map("destination_id")
  destinationName String? @map("destination_name") @db.VarChar(255)

  checkInDate  DateTime @map("check_in_date") @db.Date
  checkOutDate DateTime @map("check_out_date") @db.Date
  nights       Int

  // ── Prebook guard ────────────────────────────────────────────────────────
  // WBE: "Once OptionDetailsV2 has been called with Prebook = true, it cannot
  // be called again with Prebook = true for the same booking flow." This
  // timestamp is the guard — a non-NULL value blocks a second prebook.
  prebookedAt DateTime? @map("prebooked_at")

  /// Price shown to the user from OptionDetailsV2 with Prebook=false.
  quotedPrice    Decimal? @map("quoted_price") @db.Decimal(12, 2)
  /// Price returned by OptionDetailsV2 with Prebook=true. When this differs
  /// from `quotedPrice`, WBE requires the user to accept the difference
  /// before BookV2 may be called.
  prebookPrice   Decimal? @map("prebook_price") @db.Decimal(12, 2)
  /// Set once the user has explicitly accepted a quoted→prebook price change.
  priceChangeAcceptedAt DateTime? @map("price_change_accepted_at")

  /// Final booked amount as confirmed by WBE.
  totalPrice Decimal? @map("total_price") @db.Decimal(12, 2)
  currency   String?  @db.VarChar(10)

  // ── Cancellation policy ──────────────────────────────────────────────────
  nonRefundable          Boolean?  @map("non_refundable")
  cancellationDeadline   DateTime? @map("cancellation_deadline")
  cancellationConditions String?   @map("cancellation_conditions")

  paymentOption Int     @default(1) @map("payment_option")
  isPaid        Boolean @default(false) @map("is_paid")

  hotelNotes      String? @map("hotel_notes") @db.VarChar(250)
  carbonCopyMail  String? @map("carbon_copy_mail") @db.VarChar(255)
  /// Whether IssueVoucher=true was sent with BookV2. Default false: vouchers
  /// are issued via the dedicated IssueVoucher call so booking and voucher
  /// stay independently controllable.
  issueVoucherOnBook Boolean @default(false) @map("issue_voucher_on_book")

  voucheredAt DateTime? @map("vouchered_at")
  voucherData Json?     @map("voucher_data")

  cancelledAt         DateTime? @map("cancelled_at")
  cancellationCharge  Decimal?  @map("cancellation_charge") @db.Decimal(12, 2)

  supplierCode  String? @map("supplier_code") @db.VarChar(50)
  essentialInfo String? @map("essential_info")

  /// Populated by WBE only from ~7 days before check-in; requires repeated
  /// BookingDetails polling to appear.
  hotelConfirmationNumber String? @map("hotel_confirmation_number") @db.VarChar(255)

  /// Error surfaced by the supplier when a booking failed or is stuck in PNDN.
  originalProviderResponse String? @map("original_provider_response")
  /// Last error we recorded against this booking, for staff diagnostics.
  lastError String? @map("last_error")

  /// Verbatim BookV2 request/response, retained for audit and for WBE support
  /// tickets. Never read back by application logic.
  bookRequestPayload  Json? @map("book_request_payload")
  bookResponsePayload Json? @map("book_response_payload")

  /// Marks rows created by the XMLOUT certification runner so certification
  /// traffic can be excluded from business reporting.
  isCertificationTest Boolean @default(false) @map("is_certification_test")
  /// Scenario number (1-14) from WBE's certification document.
  certificationScenario Int? @map("certification_scenario")

  /// Optional link back to the originating group request. NULL for bookings
  /// made outside the request flow (e.g. certification runs).
  requestId String?         @map("request_id") @db.Uuid
  request   BookingRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  bookedAt     DateTime? @map("booked_at")
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")

  rooms BookingRoom[]

  @@index([status])
  @@index([wbeStatus])
  @@index([requestId])
  @@index([createdById])
  @@index([checkInDate])
  @@index([createdAt])
  @@index([isCertificationTest])
  @@index([cancellationDeadline])
  @@map("bookings")
  @@schema("app")
}

model BookingRoom {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @map("booking_id") @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// 1-based room index as sent to WBE (`RoomId`). Must match the index used
  /// in the originating search request.
  roomId Int @map("room_id")

  adultsNo   Int @map("adults_no")
  childrenNo Int @map("children_no")

  roomDescription String?  @map("room_description") @db.VarChar(500)
  mealType        String?  @map("meal_type") @db.VarChar(10)
  mealName        String?  @map("meal_name") @db.VarChar(255)
  price           Decimal? @db.Decimal(12, 2)

  /// Chosen `SupplementId` values sent as OptionalExtras for this room.
  optionalExtras Json? @map("optional_extras")

  createdAt DateTime @default(now()) @map("created_at")

  passengers BookingPassenger[]

  @@unique([bookingId, roomId])
  @@index([bookingId])
  @@map("booking_rooms")
  @@schema("app")
}

model BookingPassenger {
  id     String      @id @default(uuid()) @db.Uuid
  roomId String      @map("room_id") @db.Uuid
  room   BookingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// Mr | Ms | Mrs | Miss for adults, Chd for children.
  salutation String @db.VarChar(10)
  firstName  String @map("first_name") @db.VarChar(100)
  lastName   String @map("last_name") @db.VarChar(100)
  isChild    Boolean @map("is_child")

  /// Required for children, and MUST be omitted (not zero) for adults when
  /// building the BookV2 payload. Nullable here so that distinction survives
  /// the round trip — a 0 would be sent to WBE and rejected.
  age Int?

  /// Marks the lead passenger, used for voucher `Leader` output.
  isLeader Boolean @default(false) @map("is_leader")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId])
  @@map("booking_passengers")
  @@schema("app")
}

/// Internal booking lifecycle. Tracks OUR position in the flow, including
/// states that exist before WBE is ever contacted.
enum BookingFlowStatus {
  /// Row created, option selected, nothing sent to WBE yet.
  draft
  /// OptionDetailsV2 with Prebook=true succeeded; BookV2 not yet called.
  prebooked
  /// Prebook returned a different price; awaiting user acceptance.
  price_changed
  /// BookV2 dispatched but no response yet — the crash-recovery window.
  booking
  /// BookV2 returned a booking reference.
  booked
  /// Voucher issued.
  vouchered
  /// Cancellation completed with WBE.
  cancelled
  /// Cancellation requested but not yet settled (WBE status PNDC).
  pending_cancellation
  /// BookV2 failed, or a dispatched booking could not be recovered.
  failed

  @@schema("app")
}
