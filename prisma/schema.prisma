// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "master", "app", "cache", "audit"]
}

// --- AUDIT SCHEMA ---

enum JobStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@schema("audit")
}

model SyncJob {
  id               String    @id @default(uuid()) @db.Uuid
  type             String // "HOTELS_LIST", "HOTEL_DETAILS"
  status           JobStatus
  totalRecords     Int?
  processedRecords Int       @default(0)
  lastProcessedKey String? // hotelCode checkpoint
  errorMessage     String?
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")

  @@map("sync_jobs")
  @@schema("audit")
}

// --- AUTH SCHEMA ---

model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("user_roles")
  @@schema("auth")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  password     String    @db.Text
  firstName    String?   @map("first_name") @db.VarChar(100)
  lastName     String?   @map("last_name") @db.VarChar(100)
  roleId       String    @map("role_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  refreshToken String?   @map("refresh_token") @db.Text
  role         UserRole  @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@map("users")
  @@schema("auth")
}

// --- MASTER SCHEMA ---

model Destination {
  id           Int           @id
  name         String        @db.VarChar(255)
  countryCode  String?       @map("country_code") @db.VarChar(10)
  region       String?       @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at")
  lastSyncedAt DateTime?     @map("last_synced_at")
  metadata     Json?         @db.JsonB
  parentId     Int?          @map("parent_id")
  parent       Destination?  @relation("DestinationHierarchy", fields: [parentId], references: [id])
  children     Destination[] @relation("DestinationHierarchy")

  @@index([name])
  @@index([parentId])
  @@map("destinations")
  @@schema("master")
}

model Currency {
  code      String   @id @db.VarChar(10)
  name      String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("currencies")
  @@schema("master")
}

model Nationality {
  code      String   @id @db.VarChar(10)
  name      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("nationalities")
  @@schema("master")
}

model Language {
  code      String   @id @db.VarChar(10)
  name      String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("languages")
  @@schema("master")
}

model Hotel {
  hotelCode        String    @id @map("hotel_code") @db.VarChar(255)
  name             String    @db.VarChar(255)
  masterHotelId    Int?      @map("master_hotel_id")
  hotelDetailsUrl  String?   @map("hotel_details_url") @db.Text
  destinationId    Int?      @map("destination_id")
  starRating       Decimal?  @map("star_rating") @db.Decimal(2, 1)
  category         String?   @db.VarChar(50)
  giataCode        String?   @map("giata_code") @db.VarChar(50)
  address          String?   @db.Text
  addressCity      String?   @map("address_city") @db.VarChar(255)
  addressCountry   String?   @map("address_country") @db.VarChar(10)
  latitude         Decimal?  @db.Decimal(10, 7)
  longitude        Decimal?  @db.Decimal(10, 7)
  propertyType     Int?      @map("property_type")
  supplierCode     String?   @map("supplier_code") @db.VarChar(50)
  metadata         Json?     @db.JsonB
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSyncedAt     DateTime? @map("last_synced_at")
  detailsFetchedAt DateTime? @map("details_fetched_at")

  @@index([destinationId])
  @@index([supplierCode])
  @@index([name])
  @@map("hotels")
  @@schema("master")
}

model Facility {
  id        Int      @id
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([name])
  @@map("facilities")
  @@schema("master")
}

model HotelFacility {
  id         String   @id @default(uuid()) @db.Uuid
  hotelCode  String   @map("hotel_code") @db.VarChar(255)
  facilityId Int      @map("facility_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([hotelCode])
  @@index([facilityId])
  @@index([hotelCode, facilityId])
  @@map("hotel_facilities")
  @@schema("master")
}

model HotelImage {
  id           String   @id @default(uuid()) @db.Uuid
  hotelCode    String   @map("hotel_code") @db.VarChar(64)
  imageKey     String   @map("image_key") @db.Text
  displayOrder Int      @default(0) @map("display_order")
  caption      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([hotelCode])
  @@index([hotelCode, displayOrder])
  @@map("hotel_images")
  @@schema("master")
}

model HotelFacilityGroup {
  id         String   @id @default(uuid()) @db.Uuid
  hotelCode  String   @map("hotel_code") @db.VarChar(64)
  groupType  String   @map("group_type") @db.VarChar(20)
  category   String?  @db.VarChar(255)
  facilities Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([hotelCode])
  @@index([groupType])
  @@map("hotel_facility_groups")
  @@schema("master")
}

// --- APP SCHEMA ---

model BookingRequest {
  id                  String     @id @default(uuid()) @db.Uuid
  rawPayload          Json       @map("raw_payload") @db.JsonB
  externalRequestId   String?    @map("external_request_id") @db.VarChar(255)
  source              String?    @db.VarChar(100)
  sourceIp            String?    @map("source_ip") @db.VarChar(50)
  budget              Decimal?   @db.Decimal(12, 2)
  companyName         String?    @map("company_name") @db.VarChar(255)
  contactName         String?    @map("contact_name") @db.VarChar(255)
  contactEmail        String?    @map("contact_email") @db.VarChar(255)
  contactPhone        String?    @map("contact_phone") @db.VarChar(50)
  currencyCode        String?    @map("currency_code") @db.VarChar(10)
  destinationName     String?    @map("destination_name") @db.VarChar(255)
  destinationId       Int        @map("destination_id")
  checkinDate         DateTime   @map("checkin_date") @db.Date
  nights              Int
  rooms               Json?      @db.JsonB
  nationalityCode     String     @map("nationality_code") @db.VarChar(10)
  processed           Boolean    @default(false)
  processedAt         DateTime?  @map("processed_at")
  specialRequirements String?    @map("special_requirements") @db.Text
  status              String     @default("pending") @db.VarChar(50)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime?  @updatedAt @map("updated_at")
  proposals           Proposal[]

  @@index([destinationId])
  @@index([status])
  @@index([nationalityCode])
  @@index([createdAt])
  @@map("booking_requests")
  @@schema("app")
}

model Proposal {
  id             String            @id @default(uuid()) @db.Uuid
  requestId      String?           @map("request_id") @db.Uuid
  status         String            @default("draft") @db.VarChar(50)
  offerItems     Json?             @map("offer_items") @db.JsonB
  totalBuy       Decimal?          @map("total_buy") @db.Decimal(12, 2)
  totalSell      Decimal?          @map("total_sell") @db.Decimal(12, 2)
  markupSettings Json?             @map("markup_settings") @db.JsonB
  notes          String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime?         @updatedAt @map("updated_at")
  bookingRequest BookingRequest?   @relation(fields: [requestId], references: [id])
  hotels         ProposalHotel[]
  services       ProposalService[]

  @@index([requestId])
  @@index([status])
  @@map("proposals")
  @@schema("app")
}

model ProposalHotel {
  id               String    @id @default(uuid()) @db.Uuid
  proposalId       String    @map("proposal_id") @db.Uuid
  hotelCode        String    @map("hotel_code") @db.VarChar(255)
  tid              String    @db.VarChar(255)
  totalPrice       Decimal   @map("total_price") @db.Decimal(12, 2)
  currency         String    @db.VarChar(10)
  freeCancellation Boolean?  @map("free_cancellation")
  cancelDeadline   DateTime? @map("cancel_deadline") @db.Timestamptz
  supplierCode     String?   @map("supplier_code") @db.VarChar(50)
  rooms            Json?     @db.JsonB
  optionDetailsId  String?   @map("option_details_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  proposal         Proposal  @relation(fields: [proposalId], references: [id])

  @@index([proposalId])
  @@index([hotelCode])
  @@index([tid])
  @@index([optionDetailsId])
  @@map("proposal_hotels")
  @@schema("app")
}

model ProposalService {
  id          String    @id @default(uuid()) @db.Uuid
  proposalId  String    @map("proposal_id") @db.Uuid
  serviceName String?   @map("service_name") @db.VarChar(255)
  dateFrom    DateTime? @map("date_from") @db.Date
  dateTo      DateTime? @map("date_to") @db.Date
  buyPrice    Decimal?  @map("buy_price") @db.Decimal(12, 2)
  sellPrice   Decimal?  @map("sell_price") @db.Decimal(12, 2)
  quantity    Int?
  days        Int?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  proposal    Proposal  @relation(fields: [proposalId], references: [id])

  @@index([proposalId])
  @@map("proposal_services")
  @@schema("app")
}

// --- CACHE SCHEMA ---

model HotelOptionDetail {
  id                 String    @id @default(uuid()) @db.Uuid
  tid                String    @unique @db.VarChar(255)
  hotelCode          String?   @map("hotel_code") @db.VarChar(255)
  data               Json      @db.JsonB
  fetchedAt          DateTime  @default(now()) @map("fetched_at")
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  nonRefundable      Boolean?  @map("non_refundable")
  cxlOptionDate      DateTime? @map("cxl_option_date")
  cxlConditions      Json?     @map("cxl_conditions") @db.JsonB
  cxlComment         String?   @map("cxl_comment") @db.Text
  cxlRemarks         Json?     @map("cxl_remarks") @db.JsonB
  daypricesTotal     Decimal?  @map("dayprices_total") @db.Decimal(12, 2)
  daypricesCurrency  String?   @map("dayprices_currency") @db.VarChar(10)
  mealType           String?   @map("meal_type") @db.VarChar(10)
  mealName           String?   @map("meal_name") @db.VarChar(255)
  providerPrice      Decimal?  @map("provider_price") @db.Decimal(12, 2)
  providerCurrency   String?   @map("provider_currency") @db.VarChar(10)
  supplierCode       String?   @map("supplier_code") @db.VarChar(50)
  essentialInfo      String?   @map("essential_info") @db.Text
  priceComment       String?   @map("price_comment") @db.Text
  supplements        Json?     @db.JsonB
  optionalExtras     Json?     @map("optional_extras") @db.JsonB
  specialOffers      Json?     @map("special_offers") @db.JsonB
  rooms              Json?     @db.JsonB
  success            Boolean?
  versionDescription String?   @map("version_description") @db.VarChar(100)

  @@index([hotelCode])
  @@index([fetchedAt])
  @@index([expiresAt])
  @@index([daypricesTotal])
  @@map("hotel_option_details")
  @@schema("cache")
}
