# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Template for local/staging/prod environment configuration.
# Copy this file to `.env` and replace placeholders with real values.
# `.env` is gitignored. NEVER commit real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?pgbouncer=true&statement_cache_size=0"

# ── App ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
LOG_LEVEL="info"
CORS_ORIGIN=http://localhost:3000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="<64-byte-hex-secret>"
JWT_REFRESH_SECRET="<64-byte-hex-secret>"
JWT_ACCESS_EXPIRES="120m"
JWT_REFRESH_EXPIRES="30d"

# ── WBE (hotel supplier API) ──────────────────────────────────────────────────
WBE_API_KEY="<wbe-api-key>"
WBE_BASE_URL="https://staticuat.wbeapi.com"
WBE_SEARCH_URL="http://uat.b2b.wbeapi.com"
WBE_CONTENT_URL="https://uatcontent.wbeapi.com"
WBE_USERNAME="<wbe-username>"
WBE_PASSWORD="<wbe-password>"
WBE_ACCEPT_LANGUAGE="en"

# ── Queue ─────────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://localhost

# ── Webhook security ──────────────────────────────────────────────────────────
WEBHOOK_SECRET=<32-byte-hex-shared-secret-with-wix>
WP_WEBHOOK_SECRET=<32-byte-hex-shared-secret-with-wordpress>

# ── Email (Brevo SMTP) ────────────────────────────────────────────────────────
# Provider: Brevo (https://app.brevo.com/)
# Domain s-e-t-t.com is already SPF/DKIM-verified in Brevo — no DNS work needed.
# Variable names match Oliver's handover spec. The transport code accepts the
# legacy names (SMTP_USER/SMTP_PASS/SMTP_FROM/SMTP_SECURE/SMTP_REPLY_TO_FALLBACK)
# as fallback for backwards compatibility. Do NOT log SMTP_PASSWORD.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=STARTTLS
SMTP_USERNAME=<brevo-smtp-username>
SMTP_PASSWORD=<brevo-smtp-password>
SMTP_FROM_NAME=SETT Groups
SMTP_FROM_EMAIL=groups@s-e-t-t.com
SMTP_REPLY_TO=groups@s-e-t-t.com

# Central group inbox — receiver of transactional GroupHub notifications.
STAFF_NOTIFICATION_EMAIL=groups@s-e-t-t.com

# Comma-separated list of BookingRequestStatus transitions that fire a status-change
# email to staff. Add/remove without code changes.
NOTIFY_STATUS_TRANSITIONS=sent,completed,cancelled

# Used only by `npm run email:acceptance-test` for the external-deliverability check.
TEST_EXTERNAL_RECIPIENT=<your-personal-gmail-or-outlook>

# ── Google OAuth (still used for OAuth flow itself; not for email sending) ────
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=<32-byte-hex-key>

# ── DeepL — translation for PDF EN/DE switching ────────────────────────────────
DEEPL_API_KEY=<deepl-api-key>

# ── GIATA — hotel content sync ─────────────────────────────────────────────────
GIATA_USERNAME=<giata-username>
GIATA_PASSWORD=<giata-password>

# ── Hetzner Object Storage (S3-compatible) ─────────────────────────────────────
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<s3-access-key>
S3_SECRET_ACCESS_KEY=<s3-secret-key>

# ── Server base URL (for self-hosted email logo assets) ─────────────────────────
SERVER_BASE_URL=http://localhost:4000

# ── Frontend dashboard base URL (CTA links inside transactional emails) ─────────
# Local dev: http://localhost:3000   |   Production: https://group-ai.s-e-t-t.com
DASHBOARD_BASE_URL=http://localhost:3000
